{% extends 'layout.html.twig' %}

{% block title %}Presences{% endblock %}
{% block breadcrumb %}Administration / Vie scolaire / Presences{% endblock %}

{% block content %}
<header>
    <div>
        <p>Vie scolaire · Annee 2025 - 2026</p>
        <h1>Presences et absences</h1>
        <p>Saisie quotidienne par classe : present, absent, retard, dispense ou sortie autorisee.</p>
    </div>
</header>

{% if message %}<div class="notice success">{{ message }}</div>{% endif %}
{% if error %}<div class="notice error">{{ error }}</div>{% endif %}

<section class="stats">
    <div class="card"><small>Eleves de la liste</small><strong>{{ counts.total }}</strong></div>
    <div class="card"><small>Presents</small><strong>{{ counts.present }}</strong></div>
    <div class="card"><small>Absents</small><strong>{{ counts.absent }}</strong></div>
    <div class="card"><small>Retards</small><strong>{{ counts.late }}</strong></div>
</section>

<section class="card">
    <form class="toolbar compact" method="get">
        <label>Date<input type="date" name="date" value="{{ date }}"></label>
        <label>Classe
            <select name="class_id">
                <option value="0">Choisir une classe</option>
                {% for class in classes %}<option value="{{ class.id }}" {{ classId == class.id ? 'selected' : '' }}>{{ class.name }} · {{ class.cycle }}</option>{% endfor %}
            </select>
        </label>
        <span></span>
        <button class="button dark" type="submit">Afficher</button>
        <a class="button ghost" href="{{ path('app_attendance') }}">Reinitialiser</a>
    </form>
</section>

<section class="card">
    {% if classId < 1 %}
        <p>Selectionnez une classe et une date pour saisir les presences du jour.</p>
    {% else %}
        <form method="post">
            <input type="hidden" name="date" value="{{ date }}">
            <input type="hidden" name="class_id" value="{{ classId }}">
            <table>
                <thead><tr><th>Eleve</th><th>Cycle</th><th>Classe</th><th>Etat actuel</th><th>Saisie</th></tr></thead>
                <tbody>
                {% for student in students %}
                    {% set variant = student.status == 'Absent' ? 'danger' : (student.status == 'Retard' ? 'pending' : (student.status == 'Present' ? '' : 'muted')) %}
                    <tr>
                        <td><strong>{{ student.last_name }} {{ student.first_name }}</strong></td>
                        <td class="cycle">{{ student.cycle }}</td>
                        <td>{{ student.class_name }}</td>
                        <td><span class="status {{ variant }}">{{ student.status ?: 'Non saisi' }}</span></td>
                        <td>
                            <div class="row-fields">
                                <select name="status[{{ student.id }}]">
                                    {% for option in statuses %}
                                        <option value="{{ option }}" {{ student.status == option or (student.status is empty and option == 'Present') ? 'selected' : '' }}>{{ option }}</option>
                                    {% endfor %}
                                </select>
                                <input type="number" min="0" name="minutes_late[{{ student.id }}]" value="{{ student.minutes_late ?: 0 }}" title="Minutes de retard">
                                <input name="reason[{{ student.id }}]" value="{{ student.reason }}" placeholder="Motif">
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="5">Aucun eleve inscrit dans cette classe.</td></tr>
                {% endfor %}
                </tbody>
            </table>
            {% if students|length > 0 %}<div class="actions"><button class="button" type="submit">Enregistrer la feuille du jour</button></div>{% endif %}
        </form>
    {% endif %}
</section>
{% endblock %}
