{% extends 'layout.html.twig' %}
{% import 'students/_macros.html.twig' as students_macros %}

{% block title %}Tableau de bord{% endblock %}
{% block breadcrumb %}Administration / Tableau de bord{% endblock %}

{% block content %}
<header>
    <div>
        <p>Annee scolaire 2025 - 2026 · Abidjan</p>
        <h1>Bonjour Adama,</h1>
        <p>Voici la situation de votre etablissement aujourd'hui.</p>
    </div>
    <a class="button ghost" href="{{ path('app_students') }}">Gerer les eleves →</a>
</header>

<section class="stats">
    <div class="card"><small>Eleves enregistres</small><strong>{{ students|length }}</strong></div>
    <div class="card"><small>Inscriptions validees</small><strong>{{ validRegistrations }}</strong></div>
    <div class="card"><small>Classes ouvertes</small><strong>{{ openClasses }}</strong></div>
    <div class="card">
        <small>Repartition par cycle</small>
        {% for row in byCycle %}<p><a href="{{ path('app_students', {cycle: row.cycle}) }}">{{ row.cycle }}</a> · <strong style="font-size:14px">{{ row.total }}</strong></p>{% else %}<p>-</p>{% endfor %}
    </div>
</section>

<h2>Pilotage des modules</h2>
<section class="module-groups">
    {% for group, modules in moduleGroups %}
        <article class="card">
            <h2>{{ group }}</h2>
            <div class="module-list">
                {% for module in modules %}
                    <div class="module">
                        {% if module.route is defined %}<a href="{{ path(module.route) }}">{{ module.label }}</a>{% else %}<span>{{ module.label }}</span>{% endif %}
                        <strong>{{ module.count }}</strong>
                    </div>
                {% endfor %}
            </div>
        </article>
    {% endfor %}
</section>

<section class="card">
    <header>
        <h2>Dernieres inscriptions</h2>
        <a href="{{ path('app_students') }}">Voir tous les eleves →</a>
    </header>
    <table>
        <thead><tr><th>Eleve</th><th>Cycle</th><th>Classe</th><th>Telephone</th><th>Statut</th><th></th></tr></thead>
        <tbody>
        {% for student in students|slice(0, 8) %}
            <tr>
                <td><strong>{{ student.fullName }}</strong></td>
                <td class="cycle">{{ student.cycle }}</td>
                <td>{{ student.className }}</td>
                <td>{{ student.phone ?: '-' }}</td>
                <td>{{ students_macros.status(student.status) }}</td>
                <td><a href="{{ path('app_student_show', {id: student.id}) }}">Fiche →</a></td>
            </tr>
        {% else %}
            <tr><td colspan="6">Aucun eleve.</td></tr>
        {% endfor %}
        </tbody>
    </table>
</section>
{% endblock %}
