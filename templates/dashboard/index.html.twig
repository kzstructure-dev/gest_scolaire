<!doctype html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Ecole Horizon | Symfony</title>
    <style>
        :root { color-scheme: light; font-family: Arial, sans-serif; color: #17343a; background: #f4f8f7; }
        * { box-sizing: border-box; } body { margin: 0; } .shell { display: flex; min-height: 100vh; }
        aside { width: 230px; background: #17343a; color: #d9e6e3; padding: 26px 16px; flex-shrink: 0; }
        .brand { color: #fff; font-weight: bold; font-size: 16px; padding: 0 10px 28px; } .brand span { display: block; color: #9fb4b3; font-size: 11px; font-weight: normal; margin-top: 5px; }
        .year { border: 1px solid #33555a; border-radius: 7px; padding: 11px; margin-bottom: 22px; font-size: 11px; color: #9fb4b3; } .year strong { display: block; color: #fff; margin-top: 5px; }
        nav { display: grid; gap: 4px; } nav a { color: #a9c0be; padding: 11px; border-radius: 6px; text-decoration: none; font-size: 13px; } nav a.active, nav a:hover { color: #fff; background: #246461; }
        main { flex: 1; min-width: 0; } .topbar { height: 70px; background: #fff; border-bottom: 1px solid #e4eceb; padding: 0 38px; display: flex; justify-content: space-between; align-items: center; } .topbar span { color: #718186; font-size: 12px; } .profile { color: #17343a; font-weight: bold; font-size: 12px; } .logout-link { margin-left: 12px; color: #0f7771; font-weight: normal; }
        .content { max-width: 1320px; margin: 0 auto; padding: 34px 38px 60px; } header { display: flex; justify-content: space-between; align-items: end; margin-bottom: 28px; }
        h1 { margin: 0; font-size: 32px; } p { color: #718186; }
        .badge { background: #e4f2ef; color: #0f7771; border-radius: 6px; padding: 9px 12px; font-size: 13px; font-weight: bold; }
        .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin-bottom: 20px; }
        .card { background: #fff; border: 1px solid #e4eceb; border-radius: 10px; padding: 18px; box-shadow: 0 8px 22px rgba(18,52,59,.04); }
        .card small { color: #718186; } .card strong { display: block; font-size: 28px; margin-top: 8px; }
        .section-title { margin: 30px 0 12px; font-size: 18px; }
        .module-groups { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; margin-bottom: 26px; }
        .module-group { background: #fff; border: 1px solid #e4eceb; border-radius: 10px; padding: 18px; }
        .module-group h2 { font-size: 15px; margin: 0 0 14px; }
        .module-list { display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; }
        .module { display: flex; justify-content: space-between; align-items: center; background: #f4f8f7; border-radius: 6px; padding: 9px 10px; font-size: 12px; }
        .module a { color: #17343a; font-weight: bold; text-decoration: none; }
        .module a:hover { color: #0f7771; }
        .module strong { font-size: 15px; color: #0f7771; }
        table { width: 100%; border-collapse: collapse; background: #fff; border: 1px solid #e4eceb; border-radius: 10px; overflow: hidden; }
        th, td { padding: 13px 16px; border-bottom: 1px solid #edf2f1; text-align: left; font-size: 13px; }
        th { color: #718186; font-size: 11px; text-transform: uppercase; } .cycle { color: #0f7771; font-weight: bold; }
        @media (max-width: 850px) { aside { width: 190px; } .stats { grid-template-columns: repeat(2, 1fr); } }
        @media (max-width: 650px) { .shell { display: block; } aside { width: 100%; padding: 16px; } nav { grid-template-columns: repeat(3, 1fr); } .topbar { padding: 0 17px; } .content { padding: 25px 17px 45px; } .stats, .module-groups { grid-template-columns: 1fr; } .module-list { grid-template-columns: 1fr 1fr; } header { display: block; } .badge { display: inline-block; margin-top: 15px; } }
    </style>
</head>
<body><div class="shell"><aside><div class="brand">Ecole Horizon<span>Gestion scolaire</span></div><div class="year">Annee scolaire<strong>2025 - 2026</strong></div><nav><a class="active" href="{{ path('app_dashboard') }}">⌂ Tableau de bord</a><a href="{{ path('app_students') }}">◉ Eleves</a><a href="{{ path('app_classes') }}">▦ Classes</a><a href="{{ path('app_attendance') }}">✓ Presences</a><a href="{{ path('app_evaluations') }}">▤ Notes</a><a href="{{ path('app_report_cards') }}">▤ Bulletins</a><a href="{{ path('app_finance') }}">₣ Finances</a></nav></aside><main><div class="topbar"><span>Administration / Tableau de bord</span><span class="profile">{{ app.user.fullName }} · {{ app.user.role.name }}<a class="logout-link" href="{{ path('app_logout') }}">Deconnexion</a></span></div><div class="content">
<header>
    <div><p>Mercredi 19 Aout 2026 · Abidjan</p><h1>Bonjour Adama,</h1><p>Voici la situation de votre etablissement aujourd'hui.</p></div>
    <span class="badge">Symfony 8 · PHP 8.4</span>
</header>
<section class="stats">
    <article class="card"><small>Eleves inscrits</small><strong>{{ students|length }}</strong><small>Donnees SQLite a jour</small></article>
    <article class="card"><small>Primaire</small><strong>{{ primaryCount }}</strong><small>Eleves du cycle</small></article>
    <article class="card"><small>Secondaire</small><strong>{{ secondaryCount }}</strong><small>College et lycee</small></article>
    <article class="card"><small>Inscriptions validees</small><strong>{{ moduleGroups.Scolarite[1].count }}</strong><small>Pour 2025 - 2026</small></article>
</section>
<h2 id="modules" class="section-title">Pilotage des modules</h2><section class="module-groups">
    {% for group, modules in moduleGroups %}
        <article class="module-group">
            <h2>{{ group }}</h2>
            <div class="module-list">
                {% for module in modules %}
                    <div class="module">{% if module.route is defined %}<a href="{{ path(module.route) }}">{{ module.label }}</a>{% else %}<span>{{ module.label }}</span>{% endif %}<strong>{{ module.count }}</strong></div>
                {% endfor %}
            </div>
        </article>
    {% endfor %}
</section>
<h2 id="students" class="section-title">Dernieres inscriptions</h2>
<table>
    <thead><tr><th>Eleve</th><th>Cycle</th><th>Classe</th><th>Telephone</th><th>Statut</th></tr></thead>
    <tbody>
    {% for student in students %}
        <tr><td><strong>{{ student.fullName }}</strong></td><td class="cycle">{{ student.cycle }}</td><td>{{ student.className }}</td><td>{{ student.phone }}</td><td>{{ student.status }}</td></tr>
    {% else %}
        <tr><td colspan="5">Aucun eleve.</td></tr>
    {% endfor %}
    </tbody>
</table>
</div></main></div></body>
</html>
