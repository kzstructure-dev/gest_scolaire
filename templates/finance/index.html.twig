<!doctype html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Ecole Horizon | Finances</title>
    <style>
        :root { font-family: Arial, sans-serif; color: #17343a; background: #f4f8f7; } * { box-sizing: border-box; }
        body { margin: 0; } .shell { display: flex; min-height: 100vh; } aside { width: 230px; background: #17343a; color: #d9e6e3; padding: 26px 16px; flex-shrink: 0; }
        .brand { color: #fff; font-weight: bold; font-size: 16px; padding: 0 10px 28px; } .brand span { display: block; color: #9fb4b3; font-size: 11px; font-weight: normal; margin-top: 5px; }
        .year { border: 1px solid #33555a; border-radius: 7px; padding: 11px; margin-bottom: 22px; font-size: 11px; color: #9fb4b3; } .year strong { display: block; color: #fff; margin-top: 5px; }
        nav { display: grid; gap: 4px; } nav a { color: #a9c0be; padding: 11px; border-radius: 6px; text-decoration: none; font-size: 13px; } nav a.active, nav a:hover { color: #fff; background: #246461; }
        main { flex: 1; min-width: 0; } .topbar { height: 70px; background: #fff; border-bottom: 1px solid #e4eceb; padding: 0 38px; display: flex; justify-content: space-between; align-items: center; color: #718186; font-size: 12px; } .profile { color: #17343a; font-weight: bold; } .logout-link { margin-left: 12px; color: #0f7771; font-weight: normal; }
        .content { max-width: 1320px; margin: 0 auto; padding: 34px 38px 60px; } header { display: flex; justify-content: space-between; align-items: end; margin-bottom: 24px; } h1 { margin: 0; font-size: 30px; } h2 { margin: 0 0 14px; font-size: 16px; } p { color: #718186; }
        .stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin-bottom: 18px; } .card { background: #fff; border: 1px solid #e4eceb; border-radius: 10px; padding: 18px; margin-bottom: 18px; } .card small { color: #718186; } .card strong { display: block; font-size: 28px; margin-top: 8px; }
        .notice { padding: 11px 14px; border-radius: 6px; margin-bottom: 16px; font-size: 13px; } .success { background: #e5f4ed; color: #246d57; } .error { background: #fcebe7; color: #a54d3d; }
        .form-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; align-items: end; } label { display: grid; gap: 6px; color: #718186; font-size: 11px; font-weight: bold; }
        input, select { border: 1px solid #dce8e6; border-radius: 6px; padding: 11px; background: #fff; color: #17343a; }
        .button { border: 0; background: #0f7771; color: #fff; border-radius: 6px; padding: 11px 14px; font-weight: bold; cursor: pointer; text-decoration: none; display: inline-block; }
        table { width: 100%; border-collapse: collapse; } th, td { padding: 13px 10px; border-bottom: 1px solid #edf2f1; text-align: left; font-size: 13px; } th { color: #718186; font-size: 10px; text-transform: uppercase; }
        .status { display: inline-block; padding: 5px 8px; border-radius: 12px; background: #fff3dd; color: #9b6a13; font-size: 11px; } .Payee { background: #e5f4ed; color: #246d57; } .A { background: #fcebe7; color: #a54d3d; }
        .split { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
        @media (max-width: 950px) { .split, .form-grid { grid-template-columns: 1fr; } .stats { grid-template-columns: 1fr; } }
        @media (max-width: 650px) { .shell { display: block; } aside { width: 100%; padding: 16px; } nav { grid-template-columns: repeat(3, 1fr); } .content { padding: 25px 17px 45px; } .topbar { padding: 0 17px; } .card { overflow-x: auto; } table { min-width: 760px; } }
    </style>
</head>
<body><div class="shell"><aside><div class="brand">Ecole Horizon<span>Gestion scolaire</span></div><div class="year">Annee scolaire<strong>2025 - 2026</strong></div>{{ include('partials/_sidebar_nav.html.twig', { active: 'finance' }) }}</aside><main><div class="topbar"><span>Administration / Caisse / Finances</span><span class="profile">{{ app.user.fullName }} · {{ app.user.role.name }}<a class="logout-link" href="{{ path('app_logout') }}">Deconnexion</a></span></div><div class="content">
<header><div><p>Comptabilite · Annee 2025 - 2026</p><h1>Frais, paiements et recus</h1><p>Facturer un eleve, enregistrer un paiement partiel ou complet, imprimer le recu.</p></div></header>
{% if message %}<div class="notice success">{{ message }}</div>{% endif %}{% if error %}<div class="notice error">{{ error }}</div>{% endif %}
<section class="stats">
    <article class="card"><small>Encaisse (F CFA)</small><strong>{{ collected|number_format(0, ',', ' ') }}</strong></article>
    <article class="card"><small>Reste a payer</small><strong>{{ outstanding|number_format(0, ',', ' ') }}</strong></article>
    <article class="card"><small>Factures</small><strong>{{ invoiceCount }}</strong></article>
</section>
<div class="split">
<section class="card"><h2>Nouveau tarif</h2><form class="form-grid" method="post"><input type="hidden" name="action" value="tariff"><label>Libelle<input name="label" required placeholder="Scolarite trimestre 2"></label><label>Montant<input type="number" name="amount" min="1" step="1" required></label><label>Echeance<input type="date" name="due_date"></label><label>Niveau<select name="level_id"><option value="0">Tous niveaux</option>{% for level in levels %}<option value="{{ level.id }}">{{ level.name }}</option>{% endfor %}</select></label><button class="button" type="submit">Ajouter</button></form></section>
<section class="card"><h2>Nouvelle facture</h2><form class="form-grid" method="post"><input type="hidden" name="action" value="invoice"><label>Eleve<select name="student_id" required><option value="">Choisir</option>{% for student in students %}<option value="{{ student.id }}">{{ student.last_name }} {{ student.first_name }} · {{ student.class_name }}</option>{% endfor %}</select></label><label>Tarif<select name="tariff_id" required>{% for tariff in tariffs %}<option value="{{ tariff.id }}">{{ tariff.label }} · {{ tariff.amount|number_format(0, ',', ' ') }} F</option>{% endfor %}</select></label><button class="button" type="submit">Facturer</button></form></section>
</div>
<section class="card"><h2>Enregistrer un paiement</h2><form class="form-grid" method="post"><input type="hidden" name="action" value="payment"><label>Facture ouverte<select name="invoice_id" required><option value="">Choisir</option>{% for invoice in openInvoices %}<option value="{{ invoice.id }}">{{ invoice.invoice_number }} · {{ invoice.last_name }} {{ invoice.first_name }} · reste {{ invoice.remaining|number_format(0, ',', ' ') }} F</option>{% endfor %}</select></label><label>Montant<input type="number" name="amount" min="1" step="1" required></label><label>Mode<select name="method">{% for method in methods %}<option value="{{ method }}">{{ method }}</option>{% endfor %}</select></label><label>Date<input type="date" name="payment_date" value="{{ 'now'|date('Y-m-d') }}" required></label><button class="button" type="submit">Encaisser</button></form></section>
<section class="card"><h2>Factures</h2><table><thead><tr><th>N°</th><th>Eleve</th><th>Frais</th><th>Montant</th><th>Paye</th><th>Reste</th><th>Echeance</th><th>Statut</th></tr></thead><tbody>{% for invoice in invoices %}<tr><td>{{ invoice.invoice_number }}</td><td><strong>{{ invoice.last_name }} {{ invoice.first_name }}</strong><br><small>{{ invoice.class_name }}</small></td><td>{{ invoice.tariff_label }}</td><td>{{ invoice.amount|number_format(0, ',', ' ') }}</td><td>{{ invoice.paid|number_format(0, ',', ' ') }}</td><td>{{ invoice.remaining|number_format(0, ',', ' ') }}</td><td>{{ invoice.due_date ?: '-' }}</td><td><span class="status {{ invoice.status }}">{{ invoice.status }}</span></td></tr>{% else %}<tr><td colspan="8">Aucune facture.</td></tr>{% endfor %}</tbody></table></section>
<section class="card"><h2>Derniers paiements</h2><table><thead><tr><th>Date</th><th>Eleve</th><th>Facture</th><th>Montant</th><th>Mode</th><th>Recu</th><th></th></tr></thead><tbody>{% for payment in payments %}<tr><td>{{ payment.payment_date }}</td><td>{{ payment.last_name }} {{ payment.first_name }}</td><td>{{ payment.invoice_number }}</td><td>{{ payment.amount|number_format(0, ',', ' ') }} F</td><td>{{ payment.method }}</td><td>{{ payment.receipt_number ?: '-' }}</td><td>{% if payment.receipt_number %}<a class="button" href="{{ path('app_finance_receipt', {id: payment.id}) }}">Voir</a>{% endif %}</td></tr>{% else %}<tr><td colspan="7">Aucun paiement.</td></tr>{% endfor %}</tbody></table></section>
</div></main></div></body></html>
