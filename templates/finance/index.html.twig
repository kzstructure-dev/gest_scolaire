{% extends 'layout.html.twig' %}

{% block title %}Finances{% endblock %}
{% block breadcrumb %}Administration / Caisse / Finances{% endblock %}

{% block content %}
<header>
    <div>
        <p>Comptabilite · Annee 2025 - 2026</p>
        <h1>Frais, paiements et recus</h1>
        <p>Facturer un eleve, enregistrer un paiement partiel ou complet, imprimer le recu.</p>
    </div>
</header>

{% if message %}<div class="notice success">{{ message }}</div>{% endif %}
{% if error %}<div class="notice error">{{ error }}</div>{% endif %}

<section class="stats">
    <div class="card"><small>Encaisse (F CFA)</small><strong>{{ collected|number_format(0, ',', ' ') }}</strong></div>
    <div class="card"><small>Reste a payer</small><strong>{{ outstanding|number_format(0, ',', ' ') }}</strong></div>
    <div class="card"><small>Factures</small><strong>{{ invoiceCount }}</strong></div>
    <div class="card"><small>Factures ouvertes</small><strong>{{ openInvoices|length }}</strong></div>
</section>

<div class="grid-2">
    <section class="card">
        <h2>Nouveau tarif</h2>
        <form class="form-grid" method="post">
            <input type="hidden" name="action" value="tariff">
            <label>Libelle<input name="label" required placeholder="Scolarite trimestre 2"></label>
            <label>Montant<input type="number" name="amount" min="1" step="1" required></label>
            <label>Echeance<input type="date" name="due_date"></label>
            <label>Niveau
                <select name="level_id">
                    <option value="0">Tous niveaux</option>
                    {% for level in levels %}<option value="{{ level.id }}">{{ level.name }}</option>{% endfor %}
                </select>
            </label>
            <button class="button" type="submit">Ajouter</button>
        </form>
    </section>
    <section class="card">
        <h2>Nouvelle facture</h2>
        <form class="form-grid" method="post">
            <input type="hidden" name="action" value="invoice">
            <label>Eleve
                <select name="student_id" required>
                    <option value="">Choisir</option>
                    {% for student in students %}<option value="{{ student.id }}">{{ student.last_name }} {{ student.first_name }} · {{ student.class_name }}</option>{% endfor %}
                </select>
            </label>
            <label>Tarif
                <select name="tariff_id" required>
                    {% for tariff in tariffs %}<option value="{{ tariff.id }}">{{ tariff.label }} · {{ tariff.amount|number_format(0, ',', ' ') }} F</option>{% endfor %}
                </select>
            </label>
            <button class="button" type="submit">Facturer</button>
        </form>
    </section>
</div>

<section class="card">
    <h2>Enregistrer un paiement</h2>
    <form class="form-grid" method="post">
        <input type="hidden" name="action" value="payment">
        <label>Facture ouverte
            <select name="invoice_id" required>
                <option value="">Choisir</option>
                {% for invoice in openInvoices %}<option value="{{ invoice.id }}">{{ invoice.invoice_number }} · {{ invoice.last_name }} {{ invoice.first_name }} · reste {{ invoice.remaining|number_format(0, ',', ' ') }} F</option>{% endfor %}
            </select>
        </label>
        <label>Montant<input type="number" name="amount" min="1" step="1" required></label>
        <label>Mode
            <select name="method">
                {% for method in methods %}<option value="{{ method }}">{{ method }}</option>{% endfor %}
            </select>
        </label>
        <label>Date<input type="date" name="payment_date" value="{{ 'now'|date('Y-m-d') }}" required></label>
        <button class="button" type="submit">Encaisser</button>
    </form>
</section>

<section class="card">
    <h2>Factures</h2>
    <table>
        <thead>
        <tr><th>N°</th><th>Eleve</th><th>Frais</th><th>Montant</th><th>Paye</th><th>Reste</th><th>Echeance</th><th>Statut</th></tr>
        </thead>
        <tbody>
        {% for invoice in invoices %}
            <tr>
                <td>{{ invoice.invoice_number }}</td>
                <td><strong>{{ invoice.last_name }} {{ invoice.first_name }}</strong><br><small>{{ invoice.class_name }}</small></td>
                <td>{{ invoice.tariff_label }}</td>
                <td>{{ invoice.amount|number_format(0, ',', ' ') }}</td>
                <td>{{ invoice.paid|number_format(0, ',', ' ') }}</td>
                <td>{{ invoice.remaining|number_format(0, ',', ' ') }}</td>
                <td>{{ invoice.due_date ?: '-' }}</td>
                <td><span class="status {{ invoice.status == 'Payee' ? '' : (invoice.remaining > 0 and invoice.paid > 0 ? 'pending' : 'danger') }}">{{ invoice.status }}</span></td>
            </tr>
        {% else %}
            <tr><td colspan="8">Aucune facture.</td></tr>
        {% endfor %}
        </tbody>
    </table>
</section>

<section class="card">
    <h2>Derniers paiements</h2>
    <table>
        <thead>
        <tr><th>Date</th><th>Eleve</th><th>Facture</th><th>Montant</th><th>Mode</th><th>Recu</th><th></th></tr>
        </thead>
        <tbody>
        {% for payment in payments %}
            <tr>
                <td>{{ payment.payment_date }}</td>
                <td>{{ payment.last_name }} {{ payment.first_name }}</td>
                <td>{{ payment.invoice_number }}</td>
                <td>{{ payment.amount|number_format(0, ',', ' ') }} F</td>
                <td>{{ payment.method }}</td>
                <td>{{ payment.receipt_number ?: '-' }}</td>
                <td>{% if payment.receipt_number %}<a href="{{ path('app_finance_receipt', {id: payment.id}) }}">Recu →</a>{% endif %}</td>
            </tr>
        {% else %}
            <tr><td colspan="7">Aucun paiement.</td></tr>
        {% endfor %}
        </tbody>
    </table>
</section>
{% endblock %}
