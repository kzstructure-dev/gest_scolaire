<!doctype html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Ecole Horizon | {% block title %}Gestion scolaire{% endblock %}</title>
    <style>
        :root { font-family: Arial, sans-serif; color: #17343a; background: #f4f8f7; }
        * { box-sizing: border-box; }
        body { margin: 0; }
        a { color: #0f7771; }
        .shell { display: flex; min-height: 100vh; }
        aside { width: 230px; background: #17343a; color: #d9e6e3; padding: 26px 16px; flex-shrink: 0; }
        .brand { color: #fff; font-weight: bold; font-size: 16px; padding: 0 10px 28px; }
        .brand span { display: block; color: #9fb4b3; font-size: 11px; font-weight: normal; margin-top: 5px; }
        .year { border: 1px solid #33555a; border-radius: 7px; padding: 11px; margin-bottom: 22px; font-size: 11px; color: #9fb4b3; }
        .year strong { display: block; color: #fff; margin-top: 5px; }
        nav { display: grid; gap: 4px; }
        nav a { color: #a9c0be; padding: 11px; border-radius: 6px; text-decoration: none; font-size: 13px; }
        nav a.active, nav a:hover { color: #fff; background: #246461; }
        main { flex: 1; min-width: 0; }
        .topbar { height: 70px; background: #fff; border-bottom: 1px solid #e4eceb; padding: 0 38px; display: flex; justify-content: space-between; align-items: center; color: #718186; font-size: 12px; }
        .profile { color: #17343a; font-weight: bold; }
        .content { max-width: 1320px; margin: 0 auto; padding: 34px 38px 60px; }
        header { display: flex; justify-content: space-between; align-items: end; gap: 16px; margin-bottom: 24px; }
        h1 { margin: 0; font-size: 30px; }
        h2 { margin: 0 0 14px; font-size: 17px; }
        p { color: #718186; margin: 6px 0; }
        .button { display: inline-block; border: 0; background: #0f7771; color: #fff; border-radius: 6px; padding: 11px 14px; font-weight: bold; font-size: 13px; cursor: pointer; text-decoration: none; }
        .button.ghost { background: #fff; color: #17343a; border: 1px solid #dce8e6; }
        .button.dark { background: #17343a; }
        .card { background: #fff; border: 1px solid #e4eceb; border-radius: 10px; padding: 20px; margin-bottom: 18px; }
        .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin-bottom: 18px; }
        .stats .card { margin: 0; }
        .stats small { color: #718186; font-size: 11px; text-transform: uppercase; }
        .stats strong { display: block; font-size: 26px; margin-top: 8px; }
        .notice { padding: 11px 14px; border-radius: 6px; margin-bottom: 16px; font-size: 13px; }
        .success { background: #e5f4ed; color: #246d57; }
        .error { background: #fcebe7; color: #a54d3d; }
        input, select, textarea { border: 1px solid #dce8e6; border-radius: 6px; padding: 11px; background: #fff; color: #17343a; font-family: inherit; font-size: 13px; width: 100%; }
        label { display: grid; gap: 6px; color: #718186; font-size: 11px; font-weight: bold; }
        .form-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; align-items: end; }
        .toolbar { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr 1fr auto auto; gap: 10px; align-items: end; }
        .toolbar.compact { grid-template-columns: 2fr 1fr 1fr auto auto; }
        .progress { width: 110px; height: 7px; background: #e7efed; border-radius: 10px; overflow: hidden; }
        .progress span { display: block; height: 100%; background: #0f7771; }
        .progress span.full { background: #a54d3d; }
        table { width: 100%; border-collapse: collapse; }
        th, td { padding: 13px 10px; border-bottom: 1px solid #edf2f1; text-align: left; font-size: 13px; }
        th { color: #718186; font-size: 10px; text-transform: uppercase; }
        tbody tr:hover { background: #f8fbfa; }
        .cycle { color: #0f7771; font-weight: bold; }
        .group-row th { background: #f1f7f5; color: #0f7771; font-size: 11px; letter-spacing: .04em; }
        .group-row:hover { background: #f1f7f5; }
        .group-row .badge { color: #718186; font-weight: normal; text-transform: none; letter-spacing: 0; margin-left: 8px; }
        .group-row a { margin-left: 10px; text-transform: none; letter-spacing: 0; }
        .status { display: inline-block; padding: 5px 8px; border-radius: 12px; background: #e5f4ed; color: #246d57; font-size: 11px; white-space: nowrap; }
        .status.pending { background: #fff3dd; color: #9b6a13; }
        .status.danger { background: #fcebe7; color: #a54d3d; }
        .status.muted { background: #eef2f2; color: #6a7b7d; }
        .row-fields { display: grid; grid-template-columns: 160px 90px 1fr; gap: 8px; }
        .actions { display: flex; align-items: center; gap: 10px; margin-top: 16px; }
        .actions > :last-child { margin-left: auto; }
        .pagination { display: flex; gap: 8px; align-items: center; justify-content: space-between; margin-top: 16px; font-size: 12px; color: #718186; }
        .pagination div { display: flex; gap: 8px; }
        .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; align-items: start; }
        .module-groups { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18px; align-items: start; }
        .module-list { display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; }
        .module { display: flex; justify-content: space-between; align-items: center; gap: 8px; background: #f4f8f7; border-radius: 6px; padding: 9px 10px; font-size: 12px; }
        .module a { color: #17343a; font-weight: bold; text-decoration: none; }
        .module a:hover { color: #0f7771; }
        .module strong { font-size: 15px; color: #0f7771; }
        .card > header { margin-bottom: 14px; align-items: center; }
        .card > header h2 { margin: 0; }
        .facts { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; }
        .facts div { border-bottom: 1px solid #edf2f1; padding-bottom: 8px; }
        .facts small { display: block; color: #718186; font-size: 10px; text-transform: uppercase; }
        .facts strong { font-size: 14px; }
        @media (max-width: 1050px) { .toolbar { grid-template-columns: repeat(2, 1fr); } .stats { grid-template-columns: repeat(2, 1fr); } .grid-2, .module-groups { grid-template-columns: 1fr; } }
        @media (max-width: 850px) { aside { width: 190px; } .form-grid { grid-template-columns: repeat(2, 1fr); } }
        @media (max-width: 650px) {
            .shell { display: block; } aside { width: 100%; padding: 16px; } nav { grid-template-columns: repeat(3, 1fr); }
            .content { padding: 25px 17px 45px; } .topbar { padding: 0 17px; } header { display: block; }
            .toolbar, .form-grid, .stats, .facts, .module-groups { grid-template-columns: 1fr; }
            table { min-width: 760px; } .card { overflow-x: auto; }
        }
    </style>
</head>
<body>
{% set route = app.request.attributes.get('_route') %}
<div class="shell">
    <aside>
        <div class="brand">Ecole Horizon<span>Gestion scolaire</span></div>
        <div class="year">Annee scolaire<strong>2025 - 2026</strong></div>
        <nav>
            <a href="{{ path('app_dashboard') }}" {{ route == 'app_dashboard' ? 'class="active"' : '' }}>⌂ Tableau de bord</a>
            <a href="{{ path('app_students') }}" {{ route starts with 'app_student' ? 'class="active"' : '' }}>◉ Eleves</a>
            <a href="{{ path('app_classes') }}" {{ route == 'app_classes' ? 'class="active"' : '' }}>▦ Classes</a>
            <a href="{{ path('app_attendance') }}" {{ route == 'app_attendance' ? 'class="active"' : '' }}>✓ Presences</a>
            <a href="{{ path('app_evaluations') }}" {{ route == 'app_evaluations' ? 'class="active"' : '' }}>▤ Notes</a>
            <a href="{{ path('app_report_cards') }}" {{ route starts with 'app_report_card' ? 'class="active"' : '' }}>▤ Bulletins</a>
            <a href="{{ path('app_finance') }}" {{ route starts with 'app_finance' ? 'class="active"' : '' }}>₣ Finances</a>
        </nav>
    </aside>
    <main>
        <div class="topbar">
            <span>{% block breadcrumb %}Administration{% endblock %}</span>
            <span class="profile">Adama Kone · Directeur</span>
        </div>
        <div class="content">
            {% for type, messages in app.flashes(['success', 'error']) %}
                {% for message in messages %}
                    <div class="notice {{ type }}">{{ message }}</div>
                {% endfor %}
            {% endfor %}
            {% block content %}{% endblock %}
        </div>
    </main>
</div>
</body>
</html>
