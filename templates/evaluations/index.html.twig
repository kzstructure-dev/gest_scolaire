{% extends 'layout.html.twig' %}

{% block title %}Notes{% endblock %}
{% block breadcrumb %}Administration / Pedagogie / Evaluations{% endblock %}

{% block content %}
<header>
    <div>
        <p>Pedagogie · Annee 2025 - 2026</p>
        <h1>Evaluations et notes</h1>
        <p>Creer une evaluation puis saisir les notes de la classe, entre 0 et le bareme.</p>
    </div>
</header>

{% if message %}<div class="notice success">{{ message }}</div>{% endif %}
{% if error %}<div class="notice error">{{ error }}</div>{% endif %}

<section class="card">
    <h2>Nouvelle evaluation</h2>
    <form class="form-grid" method="post">
        <label>Titre<input name="title" required placeholder="Devoir de mathematiques"></label>
        <label>Classe
            <select name="class_id" required>
                <option value="">Choisir</option>
                {% for class in classes %}<option value="{{ class.id }}" {{ classId == class.id ? 'selected' : '' }}>{{ class.name }} · {{ class.cycle }}</option>{% endfor %}
            </select>
        </label>
        <label>Matiere
            <select name="subject_id" required>
                <option value="">Choisir</option>
                {% for subject in subjects %}<option value="{{ subject.id }}">{{ subject.name }}</option>{% endfor %}
            </select>
        </label>
        <label>Periode
            <select name="period_id" required>
                {% for period in periods %}<option value="{{ period.id }}">{{ period.name }}</option>{% endfor %}
            </select>
        </label>
        <label>Type
            <select name="evaluation_type">
                {% for type in types %}<option value="{{ type }}">{{ type }}</option>{% endfor %}
            </select>
        </label>
        <label>Date<input type="date" name="evaluation_date" value="{{ 'now'|date('Y-m-d') }}" required></label>
        <label>Bareme<input type="number" name="scale" value="20" min="1" step="0.5" required></label>
        <label>Coefficient<input type="number" name="coefficient" value="1" min="0.5" step="0.5" required></label>
        <button class="button" type="submit">Creer et saisir</button>
    </form>
</section>

<section class="card">
    <form class="toolbar compact" method="get">
        <label>Classe
            <select name="class_id">
                <option value="0">Toutes les classes</option>
                {% for class in classes %}<option value="{{ class.id }}" {{ classId == class.id ? 'selected' : '' }}>{{ class.name }} · {{ class.cycle }}</option>{% endfor %}
            </select>
        </label>
        <span></span><span></span>
        <button class="button dark" type="submit">Filtrer</button>
        <a class="button ghost" href="{{ path('app_evaluations') }}">Reinitialiser</a>
    </form>
    <table>
        <thead>
        <tr><th>Date</th><th>Titre</th><th>Classe</th><th>Matiere</th><th>Periode</th><th>Bareme</th><th>Coeff.</th><th>Notes</th><th>Statut</th><th></th></tr>
        </thead>
        <tbody>
        {% for evaluation in evaluations %}
            <tr>
                <td>{{ evaluation.evaluation_date }}</td>
                <td><strong>{{ evaluation.title }}</strong><br><small>{{ evaluation.evaluation_type }}</small></td>
                <td>{{ evaluation.class_name }}</td>
                <td>{{ evaluation.subject_name }}</td>
                <td>{{ evaluation.period_name }}</td>
                <td>{{ evaluation.scale }}</td>
                <td>{{ evaluation.coefficient }}</td>
                <td>{{ evaluation.grade_count }}</td>
                <td><span class="status {{ evaluation.status == 'Complete' ? '' : 'pending' }}">{{ evaluation.status }}</span></td>
                <td><a href="{{ path('app_evaluation_grades', {id: evaluation.id}) }}">Saisir →</a></td>
            </tr>
        {% else %}
            <tr><td colspan="10">Aucune evaluation pour le moment.</td></tr>
        {% endfor %}
        </tbody>
    </table>
</section>
{% endblock %}
