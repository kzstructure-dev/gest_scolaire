<!doctype html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Ecole Horizon | Saisie des notes</title>
    <style>
        :root { font-family: Arial, sans-serif; color: #17343a; background: #f4f8f7; } * { box-sizing: border-box; }
        body { margin: 0; } .shell { display: flex; min-height: 100vh; } aside { width: 230px; background: #17343a; color: #d9e6e3; padding: 26px 16px; flex-shrink: 0; }
        .brand { color: #fff; font-weight: bold; font-size: 16px; padding: 0 10px 28px; } .brand span { display: block; color: #9fb4b3; font-size: 11px; font-weight: normal; margin-top: 5px; }
        .year { border: 1px solid #33555a; border-radius: 7px; padding: 11px; margin-bottom: 22px; font-size: 11px; color: #9fb4b3; } .year strong { display: block; color: #fff; margin-top: 5px; }
        nav { display: grid; gap: 4px; } nav a { color: #a9c0be; padding: 11px; border-radius: 6px; text-decoration: none; font-size: 13px; } nav a.active, nav a:hover { color: #fff; background: #246461; }
        main { flex: 1; min-width: 0; } .topbar { height: 70px; background: #fff; border-bottom: 1px solid #e4eceb; padding: 0 38px; display: flex; justify-content: space-between; align-items: center; color: #718186; font-size: 12px; } .profile { color: #17343a; font-weight: bold; } .logout-link { margin-left: 12px; color: #0f7771; font-weight: normal; }
        .content { max-width: 1320px; margin: 0 auto; padding: 34px 38px 60px; } header { display: flex; justify-content: space-between; align-items: end; margin-bottom: 24px; } h1 { margin: 0; font-size: 30px; } p { color: #718186; }
        .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin-bottom: 18px; } .card { background: #fff; border: 1px solid #e4eceb; border-radius: 10px; padding: 18px; margin-bottom: 18px; } .card small { color: #718186; } .card strong { display: block; font-size: 28px; margin-top: 8px; }
        .notice { padding: 11px 14px; border-radius: 6px; margin-bottom: 16px; font-size: 13px; } .success { background: #e5f4ed; color: #246d57; } .error { background: #fcebe7; color: #a54d3d; }
        input { border: 1px solid #dce8e6; border-radius: 6px; padding: 11px; background: #fff; color: #17343a; width: 100%; }
        .button { border: 0; background: #0f7771; color: #fff; border-radius: 6px; padding: 11px 14px; font-weight: bold; cursor: pointer; text-decoration: none; }
        .ghost { background: #17343a; } table { width: 100%; border-collapse: collapse; } th, td { padding: 13px 10px; border-bottom: 1px solid #edf2f1; text-align: left; font-size: 13px; } th { color: #718186; font-size: 10px; text-transform: uppercase; }
        .actions { display: flex; justify-content: space-between; align-items: center; margin-top: 16px; gap: 10px; } .hint { color: #718186; font-size: 13px; }
        @media (max-width: 850px) { aside { width: 190px; } .stats { grid-template-columns: repeat(2, 1fr); } }
        @media (max-width: 650px) { .shell { display: block; } aside { width: 100%; padding: 16px; } nav { grid-template-columns: repeat(3, 1fr); } .content { padding: 25px 17px 45px; } .topbar { padding: 0 17px; } .stats { grid-template-columns: 1fr; } header { display: block; } .card { overflow-x: auto; } table { min-width: 720px; } }
    </style>
</head>
<body><div class="shell"><aside><div class="brand">Ecole Horizon<span>Gestion scolaire</span></div><div class="year">Annee scolaire<strong>2025 - 2026</strong></div><nav><a href="{{ path('app_dashboard') }}">⌂ Tableau de bord</a><a href="{{ path('app_students') }}">◉ Eleves</a><a href="{{ path('app_classes') }}">▦ Classes</a><a href="{{ path('app_attendance') }}">✓ Presences</a><a class="active" href="{{ path('app_evaluations') }}">▤ Notes</a><a href="{{ path('app_report_cards') }}">▤ Bulletins</a><a href="{{ path('app_finance') }}">₣ Finances</a></nav></aside><main><div class="topbar"><span>Administration / Pedagogie / Notes</span><span class="profile">{{ app.user.fullName }} · {{ app.user.role.name }}<a class="logout-link" href="{{ path('app_logout') }}">Deconnexion</a></span></div><div class="content">
<header><div><p>{{ evaluation.class_name }} · {{ evaluation.subject_name }} · {{ evaluation.period_name }}</p><h1>{{ evaluation.title }}</h1><p>{{ evaluation.evaluation_type }} du {{ evaluation.evaluation_date }} · Bareme {{ evaluation.scale }} · Coefficient {{ evaluation.coefficient }}</p></div><a class="button ghost" href="{{ path('app_evaluations') }}">Retour</a></header>
{% if message %}<div class="notice success">{{ message }}</div>{% endif %}{% if error %}<div class="notice error">{{ error }}</div>{% endif %}
<section class="stats">
    <article class="card"><small>Eleves</small><strong>{{ students|length }}</strong></article>
    <article class="card"><small>Notes saisies</small><strong>{{ entered }}</strong></article>
    <article class="card"><small>Manquantes</small><strong>{{ missing }}</strong></article>
    <article class="card"><small>Moyenne / 20</small><strong>{{ average is not null ? average : '-' }}</strong></article>
</section>
<section class="card">
{% if students is empty %}
    <p class="hint">Aucun eleve inscrit dans cette classe. Inscrivez des eleves avant de saisir les notes.</p>
{% else %}
    <form method="post">
        <table>
            <thead><tr><th>Eleve</th><th>Note / {{ evaluation.scale }}</th><th>Note / 20</th><th>Appreciation</th></tr></thead>
            <tbody>
            {% for student in students %}
                {% set normalized = student.value is not null and student.value != '' ? (student.value / evaluation.scale * 20)|round(2) : null %}
                <tr>
                    <td><strong>{{ student.last_name }} {{ student.first_name }}</strong></td>
                    <td><input type="number" name="value[{{ student.id }}]" min="0" max="{{ evaluation.scale }}" step="0.25" value="{{ student.value }}"></td>
                    <td>{{ normalized is not null ? normalized : '-' }}</td>
                    <td><input name="appreciation[{{ student.id }}]" value="{{ student.appreciation }}" placeholder="Bien, passable..."></td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
        <div class="actions"><p class="hint">Une note vide est ignoree. Toute note doit etre comprise entre 0 et {{ evaluation.scale }}.</p><button class="button" type="submit">Enregistrer les notes</button></div>
    </form>
{% endif %}
</section>
</div></main></div></body></html>
