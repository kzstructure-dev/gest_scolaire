{% extends 'layout.html.twig' %}

{% block title %}Saisie des notes{% endblock %}
{% block breadcrumb %}Administration / Pedagogie / Notes{% endblock %}

{% block content %}
<header>
    <div>
        <p>{{ evaluation.class_name }} · {{ evaluation.subject_name }} · {{ evaluation.period_name }}</p>
        <h1>{{ evaluation.title }}</h1>
        <p>{{ evaluation.evaluation_type }} du {{ evaluation.evaluation_date }} · Bareme {{ evaluation.scale }} · Coefficient {{ evaluation.coefficient }}</p>
    </div>
    <a class="button ghost" href="{{ path('app_evaluations') }}">← Retour</a>
</header>

{% if message %}<div class="notice success">{{ message }}</div>{% endif %}
{% if error %}<div class="notice error">{{ error }}</div>{% endif %}

<section class="stats">
    <div class="card"><small>Eleves</small><strong>{{ students|length }}</strong></div>
    <div class="card"><small>Notes saisies</small><strong>{{ entered }}</strong></div>
    <div class="card"><small>Manquantes</small><strong>{{ missing }}</strong></div>
    <div class="card"><small>Moyenne / 20</small><strong>{{ average is not null ? average : '-' }}</strong></div>
</section>

<section class="card">
    {% if students is empty %}
        <p>Aucun eleve inscrit dans cette classe. Inscrivez des eleves avant de saisir les notes.</p>
    {% else %}
        <form method="post">
            <table>
                <thead><tr><th>Eleve</th><th>Note / {{ evaluation.scale }}</th><th>Note / 20</th><th>Appreciation</th></tr></thead>
                <tbody>
                {% for student in students %}
                    {% set normalized = student.value is not null and student.value != '' ? (student.value / evaluation.scale * 20)|round(2) : null %}
                    <tr>
                        <td><strong>{{ student.last_name }} {{ student.first_name }}</strong></td>
                        <td><input type="number" name="value[{{ student.id }}]" min="0" max="{{ evaluation.scale }}" step="0.25" value="{{ student.value }}"></td>
                        <td>{{ normalized is not null ? normalized : '-' }}</td>
                        <td><input name="appreciation[{{ student.id }}]" value="{{ student.appreciation }}" placeholder="Bien, passable..."></td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
            <div class="actions">
                <p>Une note vide est ignoree. Toute note doit etre comprise entre 0 et {{ evaluation.scale }}.</p>
                <button class="button" type="submit">Enregistrer les notes</button>
            </div>
        </form>
    {% endif %}
</section>
{% endblock %}
