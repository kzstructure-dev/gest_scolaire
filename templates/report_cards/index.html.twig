{% extends 'layout.html.twig' %}

{% block title %}Bulletins{% endblock %}
{% block breadcrumb %}Administration / Pedagogie / Bulletins{% endblock %}

{% block content %}
<header>
    <div>
        <p>Pedagogie · Annee 2025 - 2026</p>
        <h1>Bulletins trimestriels</h1>
        <p>Moyenne = somme(note / bareme x 20 x coefficient) / somme(coefficients), puis rang de classe.</p>
    </div>
</header>

{% if message %}<div class="notice success">{{ message }}</div>{% endif %}
{% if error %}<div class="notice error">{{ error }}</div>{% endif %}

<section class="card">
    <h2>Calcul des bulletins</h2>
    <form class="form-grid" method="post">
        <label>Classe
            <select name="class_id" required>
                <option value="">Choisir</option>
                {% for class in classes %}<option value="{{ class.id }}" {{ classId == class.id ? 'selected' : '' }}>{{ class.name }} · {{ class.cycle }}</option>{% endfor %}
            </select>
        </label>
        <label>Periode
            <select name="period_id" required>
                {% for period in periods %}<option value="{{ period.id }}" {{ periodId == period.id ? 'selected' : '' }}>{{ period.name }}</option>{% endfor %}
            </select>
        </label>
        <button class="button" type="submit">Calculer les bulletins</button>
    </form>
</section>

<section class="card">
    <form class="toolbar compact" method="get">
        <label>Classe
            <select name="class_id">
                <option value="0">Toutes les classes</option>
                {% for class in classes %}<option value="{{ class.id }}" {{ classId == class.id ? 'selected' : '' }}>{{ class.name }}</option>{% endfor %}
            </select>
        </label>
        <label>Periode
            <select name="period_id">
                <option value="0">Toutes les periodes</option>
                {% for period in periods %}<option value="{{ period.id }}" {{ periodId == period.id ? 'selected' : '' }}>{{ period.name }}</option>{% endfor %}
            </select>
        </label>
        <span></span>
        <button class="button dark" type="submit">Filtrer</button>
        <a class="button ghost" href="{{ path('app_report_cards') }}">Reinitialiser</a>
    </form>
    <table>
        <thead>
        <tr><th>Eleve</th><th>Classe</th><th>Periode</th><th>Moyenne / 20</th><th>Rang</th><th>Appreciation</th><th>Statut</th><th></th></tr>
        </thead>
        <tbody>
        {% for card in cards %}
            <tr>
                <td><strong>{{ card.last_name }} {{ card.first_name }}</strong></td>
                <td>{{ card.class_name }}</td>
                <td>{{ card.period_name }}</td>
                <td>{{ card.average is not null ? card.average : '-' }}</td>
                <td>{{ card.rank ?: '-' }}</td>
                <td>{{ card.appreciation }}</td>
                <td><span class="status">{{ card.status }}</span></td>
                <td><a href="{{ path('app_report_card_show', {id: card.id}) }}">Voir →</a></td>
            </tr>
        {% else %}
            <tr><td colspan="8">Aucun bulletin. Calculez une classe apres avoir saisi des notes.</td></tr>
        {% endfor %}
        </tbody>
    </table>
</section>
{% endblock %}
