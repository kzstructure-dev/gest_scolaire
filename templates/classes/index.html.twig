{% extends 'layout.html.twig' %}

{% block title %}Classes{% endblock %}
{% block breadcrumb %}Administration / Organisation / Classes{% endblock %}

{% block content %}
<header>
    <div>
        <p>Organisation pedagogique · Annee 2025 - 2026</p>
        <h1>Classes et effectifs</h1>
        <p>Suivi des divisions par cycle, des capacites et des inscriptions validees.</p>
    </div>
</header>

<section class="stats">
    <div class="card"><small>Classes affichees</small><strong>{{ stats.classes }}</strong></div>
    <div class="card"><small>Eleves inscrits</small><strong>{{ stats.students }}</strong></div>
    <div class="card"><small>Places restantes</small><strong>{{ stats.seats }}</strong></div>
    <div class="card"><small>Classes completes</small><strong>{{ stats.full }}</strong></div>
</section>

<section class="card">
    <form class="toolbar compact" method="get">
        <label>Recherche<input name="search" value="{{ filters.search }}" placeholder="Classe, niveau ou salle"></label>
        <label>Cycle
            <select name="cycle">
                <option value="">Tous les cycles</option>
                {% for cycle in cycles %}<option value="{{ cycle.name }}" {{ filters.cycle == cycle.name ? 'selected' : '' }}>{{ cycle.name }}</option>{% endfor %}
            </select>
        </label>
        <label>Occupation
            <select name="occupancy">
                <option value="">Toutes les classes</option>
                {% for key, label in occupancies %}<option value="{{ key }}" {{ filters.occupancy == key ? 'selected' : '' }}>{{ label }}</option>{% endfor %}
            </select>
        </label>
        <button class="button dark" type="submit">Filtrer</button>
        <a class="button ghost" href="{{ path('app_classes') }}">Reinitialiser</a>
    </form>
</section>

<section class="card">
    <table>
        <thead>
        <tr><th>Classe</th><th>Niveau</th><th>Salle</th><th>Effectif</th><th>Capacite</th><th>Occupation</th><th></th></tr>
        </thead>
        {% for group in groups %}
            <tbody>
            <tr class="group-row">
                <th colspan="7">
                    {{ group.cycle }}
                    <span class="badge">{{ group.classes|length }} classe(s) · {{ group.students }}/{{ group.capacity }} places occupees</span>
                    {% if filters.cycle != group.cycle %}
                        <a href="{{ path('app_classes', filters|merge({cycle: group.cycle})) }}">Voir uniquement ce cycle →</a>
                    {% endif %}
                </th>
            </tr>
            {% for class in group.classes %}
                {% set occupation = class.capacity > 0 ? (class.student_count / class.capacity * 100)|round : 0 %}
                <tr>
                    <td><strong>{{ class.name }}</strong></td>
                    <td>{{ class.level_name }}</td>
                    <td>{{ class.room_name ?: '-' }}</td>
                    <td>{{ class.student_count }}</td>
                    <td>{{ class.capacity }}</td>
                    <td>
                        <div class="progress"><span class="{{ occupation >= 100 ? 'full' : '' }}" style="width: {{ min(occupation, 100) }}%"></span></div>
                        <small>{{ occupation }}%{{ class.student_count > class.capacity ? ' · surcharge' : '' }}</small>
                    </td>
                    <td><a href="{{ path('app_students', {class_name: class.name}) }}">Eleves →</a></td>
                </tr>
            {% endfor %}
            </tbody>
        {% else %}
            <tbody>
            <tr><td colspan="7">Aucune classe ne correspond aux criteres.</td></tr>
            </tbody>
        {% endfor %}
    </table>
</section>
{% endblock %}
