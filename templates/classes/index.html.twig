<!doctype html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Ecole Horizon | Classes</title>
    <style>
        :root { font-family: Arial, sans-serif; color: #17343a; background: #f4f8f7; } * { box-sizing: border-box; }
        body { margin: 0; } .shell { display: flex; min-height: 100vh; } aside { width: 230px; background: #17343a; color: #d9e6e3; padding: 26px 16px; flex-shrink: 0; }
        .brand { color: #fff; font-weight: bold; font-size: 16px; padding: 0 10px 28px; } .brand span { display: block; color: #9fb4b3; font-size: 11px; font-weight: normal; margin-top: 5px; }
        .year { border: 1px solid #33555a; border-radius: 7px; padding: 11px; margin-bottom: 22px; font-size: 11px; color: #9fb4b3; } .year strong { display: block; color: #fff; margin-top: 5px; }
        nav { display: grid; gap: 4px; } nav a { color: #a9c0be; padding: 11px; border-radius: 6px; text-decoration: none; font-size: 13px; } nav a.active, nav a:hover { color: #fff; background: #246461; }
        main { flex: 1; min-width: 0; } .topbar { height: 70px; background: #fff; border-bottom: 1px solid #e4eceb; padding: 0 38px; display: flex; justify-content: space-between; align-items: center; color: #718186; font-size: 12px; } .profile { color: #17343a; font-weight: bold; } .logout-link { margin-left: 12px; color: #0f7771; font-weight: normal; }
        .content { max-width: 1320px; margin: 0 auto; padding: 34px 38px 60px; } header { display: flex; justify-content: space-between; align-items: end; margin-bottom: 24px; } h1 { margin: 0; font-size: 30px; } p { color: #718186; }
        .stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin-bottom: 18px; } .card { background: #fff; border: 1px solid #e4eceb; border-radius: 10px; padding: 18px; margin-bottom: 18px; } .card small { color: #718186; } .card strong { display: block; font-size: 28px; margin-top: 8px; }
        .toolbar { display: flex; gap: 10px; align-items: center; margin-bottom: 16px; } select, button { border: 1px solid #dce8e6; border-radius: 6px; padding: 11px 14px; background: #fff; color: #17343a; } button { background: #0f7771; border: 0; color: #fff; font-weight: bold; cursor: pointer; }
        table { width: 100%; border-collapse: collapse; } th, td { padding: 13px 10px; border-bottom: 1px solid #edf2f1; text-align: left; font-size: 13px; } th { color: #718186; font-size: 10px; text-transform: uppercase; } .cycle { color: #0f7771; font-weight: bold; } .status { display: inline-block; padding: 5px 8px; border-radius: 12px; background: #e5f4ed; color: #246d57; font-size: 11px; } .secondary { background: #fff3dd; color: #9b6a13; }
        .progress { width: 110px; height: 7px; background: #e7efed; border-radius: 10px; overflow: hidden; } .progress span { display: block; height: 100%; background: #0f7771; }
        @media (max-width: 650px) { .shell { display: block; } aside { width: 100%; padding: 16px; } nav { grid-template-columns: repeat(3, 1fr); } .content { padding: 25px 17px 45px; } .topbar { padding: 0 17px; } .stats { grid-template-columns: 1fr; } header { display: block; } .toolbar { flex-wrap: wrap; } .card { overflow-x: auto; } table { min-width: 720px; } }
    </style>
</head>
<body><div class="shell"><aside><div class="brand">Ecole Horizon<span>Gestion scolaire</span></div><div class="year">Annee scolaire<strong>2025 - 2026</strong></div><nav><a href="{{ path('app_dashboard') }}">⌂ Tableau de bord</a><a href="{{ path('app_students') }}">◉ Eleves</a><a class="active" href="{{ path('app_classes') }}">▦ Classes</a><a href="{{ path('app_attendance') }}">✓ Presences</a><a href="{{ path('app_evaluations') }}">▤ Notes</a><a href="{{ path('app_report_cards') }}">▤ Bulletins</a><a href="{{ path('app_finance') }}">₣ Finances</a></nav></aside><main><div class="topbar"><span>Administration / Organisation / Classes</span><span class="profile">{{ app.user.fullName }} · {{ app.user.role.name }}<a class="logout-link" href="{{ path('app_logout') }}">Deconnexion</a></span></div><div class="content">
<header><div><p>Organisation pedagogique · 2025 - 2026</p><h1>Classes et effectifs</h1><p>Suivi des divisions, capacites et inscriptions validees.</p></div></header>
<section class="stats"><article class="card"><small>Classes affichees</small><strong>{{ total }}</strong></article><article class="card"><small>Primaire</small><strong>{{ primaryCount }}</strong></article><article class="card"><small>Secondaire</small><strong>{{ secondaryCount }}</strong></article></section>
<section class="card"><form class="toolbar" method="get"><select name="cycle"><option value="">Primaire et secondaire</option><option value="Primaire" {% if cycle == 'Primaire' %}selected{% endif %}>Primaire</option><option value="Secondaire" {% if cycle == 'Secondaire' %}selected{% endif %}>Secondaire</option></select><button type="submit">Filtrer</button></form><table><thead><tr><th>Classe</th><th>Cycle</th><th>Niveau</th><th>Effectif</th><th>Capacite</th><th>Occupation</th></tr></thead><tbody>{% for class in classes %}{% set occupation = class.capacity > 0 ? (class.student_count / class.capacity * 100)|round : 0 %}<tr><td><strong>{{ class.name }}</strong></td><td class="cycle">{{ class.cycle }}</td><td>{{ class.level_name }}</td><td>{{ class.student_count }}</td><td>{{ class.capacity }}</td><td><div class="progress"><span style="width: {{ min(occupation, 100) }}%"></span></div><small>{{ occupation }}%</small></td></tr>{% else %}<tr><td colspan="6">Aucune classe.</td></tr>{% endfor %}</tbody></table></section>
</div></main></div></body></html>
