<!doctype html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Ecole Horizon | Eleves</title>
    <style>
        :root { font-family: Arial, sans-serif; color: #17343a; background: #f4f8f7; } * { box-sizing: border-box; }
        body { margin: 0; } .shell { display: flex; min-height: 100vh; } aside { width: 230px; background: #17343a; color: #d9e6e3; padding: 26px 16px; flex-shrink: 0; }
        .brand { color: #fff; font-weight: bold; font-size: 16px; padding: 0 10px 28px; } .brand span { display: block; color: #9fb4b3; font-size: 11px; font-weight: normal; margin-top: 5px; }
        .year { border: 1px solid #33555a; border-radius: 7px; padding: 11px; margin-bottom: 22px; font-size: 11px; color: #9fb4b3; } .year strong { display: block; color: #fff; margin-top: 5px; }
        nav { display: grid; gap: 4px; } nav a { color: #a9c0be; padding: 11px; border-radius: 6px; text-decoration: none; font-size: 13px; } nav a.active, nav a:hover { color: #fff; background: #246461; }
        main { flex: 1; min-width: 0; } .topbar { height: 70px; background: #fff; border-bottom: 1px solid #e4eceb; padding: 0 38px; display: flex; justify-content: space-between; align-items: center; color: #718186; font-size: 12px; } .profile { color: #17343a; font-weight: bold; } .logout-link { margin-left: 12px; color: #0f7771; font-weight: normal; }
        .content { max-width: 1320px; margin: 0 auto; padding: 34px 38px 60px; } header { display: flex; justify-content: space-between; align-items: end; margin-bottom: 24px; } h1 { margin: 0; font-size: 30px; } p { color: #718186; }
        .button { border: 0; background: #0f7771; color: #fff; border-radius: 6px; padding: 11px 14px; font-weight: bold; cursor: pointer; } .card { background: #fff; border: 1px solid #e4eceb; border-radius: 10px; padding: 20px; margin-bottom: 18px; }
        .notice { padding: 11px 14px; border-radius: 6px; margin-bottom: 16px; font-size: 13px; } .success { background: #e5f4ed; color: #246d57; } .error { background: #fcebe7; color: #a54d3d; }
        .toolbar { display: flex; gap: 10px; align-items: center; } input, select { border: 1px solid #dce8e6; border-radius: 6px; padding: 11px; background: #fff; color: #17343a; } input { flex: 1; min-width: 200px; } .toolbar .button { background: #17343a; }
        table { width: 100%; border-collapse: collapse; } th, td { padding: 13px 10px; border-bottom: 1px solid #edf2f1; text-align: left; font-size: 13px; } th { color: #718186; font-size: 10px; text-transform: uppercase; } .cycle { color: #0f7771; font-weight: bold; }
        .status { display: inline-block; padding: 5px 8px; border-radius: 12px; background: #e5f4ed; color: #246d57; font-size: 11px; } .pending { background: #fff3dd; color: #9b6a13; }
        .form-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; align-items: end; } label { display: grid; gap: 6px; color: #718186; font-size: 11px; font-weight: bold; }
        @media (max-width: 850px) { aside { width: 190px; } .form-grid { grid-template-columns: repeat(2, 1fr); } } @media (max-width: 650px) { .shell { display: block; } aside { width: 100%; padding: 16px; } nav { grid-template-columns: repeat(3, 1fr); } .content { padding: 25px 17px 45px; } .topbar { padding: 0 17px; } header { display: block; } .toolbar { flex-wrap: wrap; } input { min-width: 100%; } .form-grid { grid-template-columns: 1fr; } table { min-width: 760px; } .card { overflow-x: auto; } }
    </style>
</head>
<body><div class="shell"><aside><div class="brand">Ecole Horizon<span>Gestion scolaire</span></div><div class="year">Annee scolaire<strong>2025 - 2026</strong></div>{{ include('partials/_sidebar_nav.html.twig', { active: 'students' }) }}</aside><main><div class="topbar"><span>Administration / Scolarite / Eleves</span><span class="profile">{{ app.user.fullName }} · {{ app.user.role.name }}<a class="logout-link" href="{{ path('app_logout') }}">Deconnexion</a></span></div><div class="content">
<header><div><p>Scolarite · Annee 2025 - 2026</p><h1>Eleves et inscriptions</h1><p>Rechercher, filtrer et inscrire les eleves de l'etablissement.</p></div></header>
{% if message %}<div class="notice success">{{ message }}</div>{% endif %}{% if error %}<div class="notice error">{{ error }}</div>{% endif %}
<section class="card"><h2>Nouvelle inscription</h2><form class="form-grid" method="post"><label>Prenoms<input name="first_name" required></label><label>Nom<input name="last_name" required></label><label>Classe<select name="class_name" required><option value="">Choisir une classe</option>{% for class in classes %}<option value="{{ class.name }}">{{ class.name }} ({{ class.capacity }} places)</option>{% endfor %}</select></label><label>Telephone responsable<input name="phone" placeholder="07 00 00 00 00"></label><button class="button" type="submit">Enregistrer</button></form></section>
<section class="card"><form class="toolbar" method="get"><input name="search" value="{{ search }}" placeholder="Nom, classe ou telephone"><select name="cycle"><option value="">Tous les cycles</option><option value="Primaire" {% if cycle == 'Primaire' %}selected{% endif %}>Primaire</option><option value="Secondaire" {% if cycle == 'Secondaire' %}selected{% endif %}>Secondaire</option></select><button class="button" type="submit">Filtrer</button></form></section>
<section class="card"><table><thead><tr><th>Eleve</th><th>Cycle</th><th>Classe</th><th>Telephone</th><th>No inscription</th><th>Date</th><th>Statut</th></tr></thead><tbody>{% for student in students %}<tr><td><strong>{{ student.first_name }} {{ student.last_name }}</strong></td><td class="cycle">{{ student.cycle }}</td><td>{{ student.registered_class ?: student.class_name }}</td><td>{{ student.phone }}</td><td>{{ student.registration_number ?: 'Non inscrit' }}</td><td>{{ student.registration_date ?: '-' }}</td><td><span class="status {% if student.status == 'A verifier' %}pending{% endif %}">{{ student.status }}</span></td></tr>{% else %}<tr><td colspan="7">Aucun eleve ne correspond aux criteres.</td></tr>{% endfor %}</tbody></table></section>
</div></main></div></body></html>
