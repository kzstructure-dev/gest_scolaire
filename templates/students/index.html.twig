{% extends 'layout.html.twig' %}
{% import 'students/_macros.html.twig' as students_macros %}

{% block title %}Eleves{% endblock %}
{% block breadcrumb %}Administration / Scolarite / Eleves{% endblock %}

{% block content %}
<header>
    <div>
        <p>Scolarite · Annee 2025 - 2026</p>
        <h1>Eleves et inscriptions</h1>
        <p>Rechercher, filtrer, inscrire et suivre les eleves de l'etablissement.</p>
    </div>
    <a class="button ghost" href="{{ path('app_students_export', filters) }}">⤓ Exporter en CSV</a>
</header>

<section class="stats">
    <div class="card"><small>Eleves enregistres</small><strong>{{ stats.total }}</strong></div>
    <div class="card"><small>Sans inscription</small><strong>{{ stats.unregistered }}</strong></div>
    <div class="card"><small>Dossiers a verifier</small><strong>{{ stats.toCheck }}</strong></div>
    <div class="card">
        <small>Repartition par cycle</small>
        {% for row in stats.byCycle %}<p><a href="{{ path('app_students', filters|merge({cycle: row.cycle, page: 1})) }}">{{ row.cycle }}</a> · <strong style="font-size:14px">{{ row.total }}</strong></p>{% else %}<p>-</p>{% endfor %}
    </div>
</section>

<section class="card">
    <h2>Nouvelle inscription</h2>
    <form class="form-grid" method="post">
        <label>Prenoms<input name="first_name" required maxlength="120"></label>
        <label>Nom<input name="last_name" required maxlength="120"></label>
        <label>Classe
            <select name="class_name" required>
                <option value="">Choisir une classe</option>
                {% for class in classes %}
                    <option value="{{ class.name }}" {{ class.student_count >= class.capacity ? 'disabled' : '' }}>
                        {{ class.name }} ({{ class.student_count }}/{{ class.capacity }})
                    </option>
                {% endfor %}
            </select>
        </label>
        <label>Telephone responsable<input name="phone" placeholder="07 00 00 00 00" inputmode="tel"></label>
        <button class="button" type="submit">Enregistrer l'inscription</button>
    </form>
</section>

<section class="card">
    <form class="toolbar" method="get">
        <label>Recherche<input name="search" value="{{ filters.search }}" placeholder="Nom, classe ou telephone"></label>
        <label>Cycle
            <select name="cycle">
                <option value="">Tous les cycles</option>
                {% for cycle in cycles %}<option value="{{ cycle.name }}" {{ filters.cycle == cycle.name ? 'selected' : '' }}>{{ cycle.name }}</option>{% endfor %}
            </select>
        </label>
        <label>Classe
            <select name="class_name">
                <option value="">Toutes les classes</option>
                {% for class in classes %}<option value="{{ class.name }}" {{ filters.class_name == class.name ? 'selected' : '' }}>{{ class.name }}</option>{% endfor %}
            </select>
        </label>
        <label>Statut
            <select name="status">
                <option value="">Tous les statuts</option>
                {% for status in statuses %}<option value="{{ status }}" {{ filters.status == status ? 'selected' : '' }}>{{ status }}</option>{% endfor %}
            </select>
        </label>
        <label>Tri
            <select name="sort">
                <option value="recent" {{ filters.sort == 'recent' ? 'selected' : '' }}>Plus recents</option>
                <option value="name" {{ filters.sort == 'name' ? 'selected' : '' }}>Nom (A-Z)</option>
                <option value="class" {{ filters.sort == 'class' ? 'selected' : '' }}>Classe</option>
                <option value="status" {{ filters.sort == 'status' ? 'selected' : '' }}>Statut</option>
            </select>
        </label>
        <button class="button dark" type="submit">Filtrer</button>
        <a class="button ghost" href="{{ path('app_students') }}">Reinitialiser</a>
    </form>
</section>

<section class="card">
    <table>
        <thead>
        <tr><th>Eleve</th><th>Cycle</th><th>Classe</th><th>Telephone</th><th>No inscription</th><th>Date</th><th>Statut</th><th></th></tr>
        </thead>
        {% for group in groups %}
            <tbody>
            <tr class="group-row">
                <th colspan="8">
                    {{ group.cycle }}
                    <span class="badge">{{ group.students|length }} eleve(s) sur cette page</span>
                    {% if filters.cycle != group.cycle %}
                        <a href="{{ path('app_students', filters|merge({cycle: group.cycle, page: 1})) }}">Voir uniquement ce cycle →</a>
                    {% endif %}
                </th>
            </tr>
            {% for student in group.students %}
                <tr>
                    <td><strong>{{ student.last_name }} {{ student.first_name }}</strong></td>
                    <td class="cycle">{{ student.cycle }}</td>
                    <td>{{ student.registered_class ?: student.class_name }}</td>
                    <td>{{ student.phone ?: '-' }}</td>
                    <td>{{ student.registration_number ?: 'Non inscrit' }}</td>
                    <td>{{ student.registration_date ?: '-' }}</td>
                    <td>{{ students_macros.status(student.status) }}</td>
                    <td><a href="{{ path('app_student_show', {id: student.id}) }}">Fiche →</a></td>
                </tr>
            {% endfor %}
            </tbody>
        {% else %}
            <tbody>
            <tr><td colspan="8">Aucun eleve ne correspond aux criteres.</td></tr>
            </tbody>
        {% endfor %}
    </table>
    <div class="pagination">
        <span>{{ total }} eleve(s) · page {{ page }} / {{ pages }}</span>
        <div>
            {% if page > 1 %}<a class="button ghost" href="{{ path('app_students', filters|merge({page: page - 1})) }}">← Precedent</a>{% endif %}
            {% if page < pages %}<a class="button ghost" href="{{ path('app_students', filters|merge({page: page + 1})) }}">Suivant →</a>{% endif %}
        </div>
    </div>
</section>
{% endblock %}
