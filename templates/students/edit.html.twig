<!doctype html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Ecole Horizon | Fiche eleve</title>
    <style>
        :root { font-family: Arial, sans-serif; color: #17343a; background: #f4f8f7; } * { box-sizing: border-box; }
        body { margin: 0; } .shell { display: flex; min-height: 100vh; } aside { width: 230px; background: #17343a; color: #d9e6e3; padding: 26px 16px; flex-shrink: 0; }
        .brand { color: #fff; font-weight: bold; font-size: 16px; padding: 0 10px 28px; } .brand span { display: block; color: #9fb4b3; font-size: 11px; font-weight: normal; margin-top: 5px; }
        .year { border: 1px solid #33555a; border-radius: 7px; padding: 11px; margin-bottom: 22px; font-size: 11px; color: #9fb4b3; } .year strong { display: block; color: #fff; margin-top: 5px; }
        nav { display: grid; gap: 4px; } nav a { color: #a9c0be; padding: 11px; border-radius: 6px; text-decoration: none; font-size: 13px; } nav a.active, nav a:hover { color: #fff; background: #246461; }
        main { flex: 1; min-width: 0; } .topbar { height: 70px; background: #fff; border-bottom: 1px solid #e4eceb; padding: 0 38px; display: flex; justify-content: space-between; align-items: center; color: #718186; font-size: 12px; } .profile { color: #17343a; font-weight: bold; } .logout-link { margin-left: 12px; color: #0f7771; font-weight: normal; }
        .content { max-width: 820px; margin: 0 auto; padding: 34px 38px 60px; } h1 { margin: 0; font-size: 30px; } p { color: #718186; }
        .card { background: #fff; border: 1px solid #e4eceb; border-radius: 10px; padding: 20px; margin-bottom: 18px; }
        .notice { padding: 11px 14px; border-radius: 6px; margin-bottom: 16px; font-size: 13px; } .success { background: #e5f4ed; color: #246d57; } .error { background: #fcebe7; color: #a54d3d; }
        .form-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; } label { display: grid; gap: 6px; color: #718186; font-size: 11px; font-weight: bold; }
        input, select { border: 1px solid #dce8e6; border-radius: 6px; padding: 11px; background: #fff; color: #17343a; width: 100%; }
        .form-actions { display: flex; gap: 12px; align-items: center; margin-top: 18px; }
        .button { border: 0; background: #0f7771; color: #fff; border-radius: 6px; padding: 11px 14px; font-weight: bold; cursor: pointer; text-decoration: none; }
        .button.secondary { background: #e4f2ef; color: #0f7771; }
        @media (max-width: 650px) { .shell { display: block; } aside { width: 100%; padding: 16px; } nav { grid-template-columns: repeat(3, 1fr); } .content { padding: 25px 17px 45px; } .topbar { padding: 0 17px; } .form-grid { grid-template-columns: 1fr; } }
    </style>
</head>
<body><div class="shell"><aside><div class="brand">Ecole Horizon<span>Gestion scolaire</span></div><div class="year">Annee scolaire<strong>2025 - 2026</strong></div>{{ include('partials/_sidebar_nav.html.twig', { active: 'students' }) }}</aside><main><div class="topbar"><span>Administration / Scolarite / Eleves / Fiche</span><span class="profile">{{ app.user.fullName }} · {{ app.user.role.name }}<a class="logout-link" href="{{ path('app_logout') }}">Deconnexion</a></span></div><div class="content">
<header><p>Scolarite · Annee 2025 - 2026</p><h1>{{ student.first_name }} {{ student.last_name }}</h1><p>Modifier la fiche et l'inscription de l'eleve.</p></header>
{% for label, messages in app.flashes(['success', 'error']) %}{% for message in messages %}<div class="notice {{ label }}">{{ message }}</div>{% endfor %}{% endfor %}
<section class="card">
    <form method="post">
        <input type="hidden" name="_token" value="{{ csrf_token('student_edit_' ~ student.id) }}">
        <div class="form-grid">
            <label>Prenoms<input name="first_name" value="{{ student.first_name }}" required></label>
            <label>Nom<input name="last_name" value="{{ student.last_name }}" required></label>
            <label>Classe
                <select name="class_name" required>
                    {% for class in classes %}<option value="{{ class.name }}" {% if class.name == student.class_name %}selected{% endif %}>{{ class.name }} ({{ class.capacity }} places)</option>{% endfor %}
                </select>
            </label>
            <label>Telephone responsable<input name="phone" value="{{ student.phone }}" placeholder="07 00 00 00 00"></label>
            <label>Statut
                <select name="status">
                    {% for status in statuses %}<option value="{{ status }}" {% if status == student.status %}selected{% endif %}>{{ status }}</option>{% endfor %}
                </select>
            </label>
        </div>
        <div class="form-actions">
            <button class="button" type="submit">Enregistrer les modifications</button>
            <a class="button secondary" href="{{ path('app_students') }}">Annuler</a>
        </div>
    </form>
</section>
</div></main></div></body></html>
