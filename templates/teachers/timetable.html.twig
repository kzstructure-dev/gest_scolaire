<!doctype html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Ecole Horizon | Emploi du temps</title>
    <style>
        :root { font-family: Arial, sans-serif; color: #17343a; background: #f4f8f7; } * { box-sizing: border-box; }
        body { margin: 0; } .shell { display: flex; min-height: 100vh; } aside { width: 230px; background: #17343a; color: #d9e6e3; padding: 26px 16px; flex-shrink: 0; }
        .brand { color: #fff; font-weight: bold; font-size: 16px; padding: 0 10px 28px; } .brand span { display: block; color: #9fb4b3; font-size: 11px; font-weight: normal; margin-top: 5px; }
        .year { border: 1px solid #33555a; border-radius: 7px; padding: 11px; margin-bottom: 22px; font-size: 11px; color: #9fb4b3; } .year strong { display: block; color: #fff; margin-top: 5px; }
        nav { display: grid; gap: 4px; } nav a { color: #a9c0be; padding: 11px; border-radius: 6px; text-decoration: none; font-size: 13px; } nav a.active, nav a:hover { color: #fff; background: #246461; }
        main { flex: 1; min-width: 0; } .topbar { height: 70px; background: #fff; border-bottom: 1px solid #e4eceb; padding: 0 38px; display: flex; justify-content: space-between; align-items: center; color: #718186; font-size: 12px; } .profile { color: #17343a; font-weight: bold; } .logout-link { margin-left: 12px; color: #0f7771; font-weight: normal; }
        .content { max-width: 1320px; margin: 0 auto; padding: 34px 38px 60px; } header { margin-bottom: 24px; } h1 { margin: 0; font-size: 30px; } h2 { margin: 0 0 14px; font-size: 16px; } h3 { margin: 0 0 8px; font-size: 13px; } p { color: #718186; }
        .card { background: #fff; border: 1px solid #e4eceb; border-radius: 10px; padding: 18px; margin-bottom: 18px; }
        .notice { padding: 11px 14px; border-radius: 6px; margin-bottom: 16px; font-size: 13px; } .success { background: #e5f4ed; color: #246d57; } .error { background: #fcebe7; color: #a54d3d; }
        .form-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; align-items: end; } label { display: grid; gap: 6px; color: #718186; font-size: 11px; font-weight: bold; }
        input, select { border: 1px solid #dce8e6; border-radius: 6px; padding: 11px; background: #fff; color: #17343a; }
        .button { border: 0; background: #0f7771; color: #fff; border-radius: 6px; padding: 9px 12px; font-weight: bold; cursor: pointer; text-decoration: none; display: inline-block; }
        .week { display: grid; grid-template-columns: repeat(6, 1fr); gap: 10px; } .day { border: 1px solid #e4eceb; border-radius: 8px; padding: 10px; min-height: 120px; }
        .slot { border-left: 3px solid #0f7771; background: #f4f8f7; border-radius: 6px; padding: 8px; margin-bottom: 8px; font-size: 12px; } .slot small { color: #718186; display: block; }
        @media (max-width: 1100px) { .week { grid-template-columns: repeat(2, 1fr); } }
        @media (max-width: 950px) { .form-grid { grid-template-columns: 1fr; } }
        @media (max-width: 650px) { .shell { display: block; } aside { width: 100%; padding: 16px; } nav { grid-template-columns: repeat(3, 1fr); } .content { padding: 25px 17px 45px; } .topbar { padding: 0 17px; } .week { grid-template-columns: 1fr; } }
    </style>
</head>
<body><div class="shell"><aside><div class="brand">Ecole Horizon<span>Gestion scolaire</span></div><div class="year">Annee scolaire<strong>2025 - 2026</strong></div>{{ include('partials/_sidebar_nav.html.twig', { active: 'timetable' }) }}</aside><main><div class="topbar"><span>Administration / Pedagogie / Emploi du temps</span><span class="profile">{{ app.user.fullName }} · {{ app.user.role.name }}<a class="logout-link" href="{{ path('app_logout') }}">Deconnexion</a></span></div><div class="content">
<header><p>Pedagogie · Annee 2025 - 2026</p><h1>Emploi du temps hebdomadaire</h1><p>Un creneau est refuse si l'enseignant, la classe ou la salle est deja occupe.</p></header>
{% for label, messages in app.flashes(['success', 'error']) %}{% for message in messages %}<div class="notice {{ label }}">{{ message }}</div>{% endfor %}{% endfor %}
<section class="card"><h2>Classe</h2><form class="form-grid" method="get"><label>Classe<select name="class_id"><option value="0">Choisir</option>{% for class in classes %}<option value="{{ class.id }}" {{ class.id == classId ? 'selected' : '' }}>{{ class.name }} · {{ class.cycle }}</option>{% endfor %}</select></label><button class="button" type="submit">Afficher</button></form></section>
<section class="card"><h2>Nouveau creneau</h2><form class="form-grid" method="post"><input type="hidden" name="action" value="schedule"><input type="hidden" name="_token" value="{{ csrf_token('timetable_schedule') }}"><input type="hidden" name="class_id" value="{{ classId }}"><label>Affectation<select name="assignment" required onchange="var v=this.value.split('|'); this.form.teacher_id.value=v[0]; this.form.subject_id.value=v[1];"><option value="">Choisir</option>{% for assignment in assignments %}<option value="{{ assignment.teacher_id }}|{{ assignment.subject_id }}">{{ assignment.subject_name }} · {{ assignment.last_name }} {{ assignment.first_name }}</option>{% endfor %}</select></label><input type="hidden" name="teacher_id" value=""><input type="hidden" name="subject_id" value=""><label>Jour<select name="weekday">{% for value, day in weekdays %}<option value="{{ value }}">{{ day }}</option>{% endfor %}</select></label><label>Debut<input type="time" name="start_time" value="08:00" required></label><label>Fin<input type="time" name="end_time" value="10:00" required></label><label>Salle<select name="room_id"><option value="0">Non definie</option>{% for room in rooms %}<option value="{{ room.id }}">{{ room.name }}</option>{% endfor %}</select></label><button class="button" type="submit">Placer</button></form></section>
<section class="card"><h2>Semaine</h2><div class="week">{% for value, day in weekdays %}<div class="day"><h3>{{ day }}</h3>{% for course in schedule[value] %}<div class="slot"><strong>{{ course.start_time }} - {{ course.end_time }}</strong><br>{{ course.subject_name }}<small>{{ course.last_name ? course.last_name ~ ' ' ~ course.first_name : 'Enseignant a definir' }}</small><small>{{ course.room_name ?: 'Salle a definir' }}</small><form method="post"><input type="hidden" name="action" value="remove"><input type="hidden" name="_token" value="{{ csrf_token('timetable_remove') }}"><input type="hidden" name="class_id" value="{{ classId }}"><input type="hidden" name="course_id" value="{{ course.id }}"><button class="button" type="submit">Retirer</button></form></div>{% else %}<p>Aucun cours.</p>{% endfor %}</div>{% endfor %}</div></section>
</div></main></div></body></html>
