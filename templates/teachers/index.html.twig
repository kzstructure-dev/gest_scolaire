<!doctype html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Ecole Horizon | Enseignants</title>
    <style>
        :root { font-family: Arial, sans-serif; color: #17343a; background: #f4f8f7; } * { box-sizing: border-box; }
        body { margin: 0; } .shell { display: flex; min-height: 100vh; } aside { width: 230px; background: #17343a; color: #d9e6e3; padding: 26px 16px; flex-shrink: 0; }
        .brand { color: #fff; font-weight: bold; font-size: 16px; padding: 0 10px 28px; } .brand span { display: block; color: #9fb4b3; font-size: 11px; font-weight: normal; margin-top: 5px; }
        .year { border: 1px solid #33555a; border-radius: 7px; padding: 11px; margin-bottom: 22px; font-size: 11px; color: #9fb4b3; } .year strong { display: block; color: #fff; margin-top: 5px; }
        nav { display: grid; gap: 4px; } nav a { color: #a9c0be; padding: 11px; border-radius: 6px; text-decoration: none; font-size: 13px; } nav a.active, nav a:hover { color: #fff; background: #246461; }
        main { flex: 1; min-width: 0; } .topbar { height: 70px; background: #fff; border-bottom: 1px solid #e4eceb; padding: 0 38px; display: flex; justify-content: space-between; align-items: center; color: #718186; font-size: 12px; } .profile { color: #17343a; font-weight: bold; } .logout-link { margin-left: 12px; color: #0f7771; font-weight: normal; }
        .content { max-width: 1320px; margin: 0 auto; padding: 34px 38px 60px; } header { margin-bottom: 24px; } h1 { margin: 0; font-size: 30px; } h2 { margin: 0 0 14px; font-size: 16px; } p { color: #718186; }
        .card { background: #fff; border: 1px solid #e4eceb; border-radius: 10px; padding: 18px; margin-bottom: 18px; }
        .notice { padding: 11px 14px; border-radius: 6px; margin-bottom: 16px; font-size: 13px; } .success { background: #e5f4ed; color: #246d57; } .error { background: #fcebe7; color: #a54d3d; }
        .form-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; align-items: end; } label { display: grid; gap: 6px; color: #718186; font-size: 11px; font-weight: bold; }
        input, select { border: 1px solid #dce8e6; border-radius: 6px; padding: 11px; background: #fff; color: #17343a; }
        .button { border: 0; background: #0f7771; color: #fff; border-radius: 6px; padding: 11px 14px; font-weight: bold; cursor: pointer; text-decoration: none; display: inline-block; }
        table { width: 100%; border-collapse: collapse; } th, td { padding: 13px 10px; border-bottom: 1px solid #edf2f1; text-align: left; font-size: 13px; } th { color: #718186; font-size: 10px; text-transform: uppercase; }
        @media (max-width: 950px) { .form-grid { grid-template-columns: 1fr; } }
        @media (max-width: 650px) { .shell { display: block; } aside { width: 100%; padding: 16px; } nav { grid-template-columns: repeat(3, 1fr); } .content { padding: 25px 17px 45px; } .topbar { padding: 0 17px; } .card { overflow-x: auto; } table { min-width: 760px; } }
    </style>
</head>
<body><div class="shell"><aside><div class="brand">Ecole Horizon<span>Gestion scolaire</span></div><div class="year">Annee scolaire<strong>2025 - 2026</strong></div>{{ include('partials/_sidebar_nav.html.twig', { active: 'teachers' }) }}</aside><main><div class="topbar"><span>Administration / Pedagogie / Enseignants</span><span class="profile">{{ app.user.fullName }} · {{ app.user.role.name }}<a class="logout-link" href="{{ path('app_logout') }}">Deconnexion</a></span></div><div class="content">
<header><p>Pedagogie · Annee 2025 - 2026</p><h1>Enseignants et affectations</h1><p>Une matiere est confiee a un seul enseignant par classe, dans la limite de {{ maxWeeklyHours }} heures hebdomadaires.</p></header>
{% for label, messages in app.flashes(['success', 'error']) %}{% for message in messages %}<div class="notice {{ label }}">{{ message }}</div>{% endfor %}{% endfor %}
<section class="card"><h2>Nouvel enseignant</h2><form class="form-grid" method="post"><input type="hidden" name="action" value="create"><input type="hidden" name="_token" value="{{ csrf_token('teacher_create') }}"><label>Prenoms<input name="first_name" required></label><label>Nom<input name="last_name" required></label><label>Specialite<input name="specialty" placeholder="Mathematiques"></label><label>Matricule<input name="registration_number" placeholder="Auto si vide"></label><label>Telephone<input name="phone"></label><label>Email<input type="email" name="email"></label><button class="button" type="submit">Ajouter</button></form></section>
<section class="card"><h2>Affecter une matiere</h2><form class="form-grid" method="post"><input type="hidden" name="action" value="assign"><input type="hidden" name="_token" value="{{ csrf_token('teacher_assign') }}"><label>Enseignant<select name="teacher_id" required><option value="">Choisir</option>{% for teacher in teachers %}<option value="{{ teacher.id }}">{{ teacher.last_name }} {{ teacher.first_name }}</option>{% endfor %}</select></label><label>Classe<select name="class_id" required><option value="">Choisir</option>{% for class in classes %}<option value="{{ class.id }}">{{ class.name }} · {{ class.cycle }}</option>{% endfor %}</select></label><label>Matiere<select name="subject_id" required><option value="">Choisir</option>{% for subject in subjects %}<option value="{{ subject.id }}">{{ subject.name }}</option>{% endfor %}</select></label><label>Heures / semaine<input type="number" name="weekly_hours" min="0.5" step="0.5" value="2" required></label><button class="button" type="submit">Affecter</button></form></section>
<section class="card"><h2>Enseignants</h2><table><thead><tr><th>Nom</th><th>Matricule</th><th>Specialite</th><th>Contact</th><th>Affectations</th><th>Heures / semaine</th></tr></thead><tbody>{% for teacher in teachers %}<tr><td><strong>{{ teacher.last_name }} {{ teacher.first_name }}</strong></td><td>{{ teacher.registration_number }}</td><td>{{ teacher.specialty ?: '-' }}</td><td>{{ teacher.phone ?: '-' }}<br><small>{{ teacher.email ?: '-' }}</small></td><td>{{ teacher.assignments }}</td><td>{{ teacher.weekly_hours }} h</td></tr>{% else %}<tr><td colspan="6">Aucun enseignant.</td></tr>{% endfor %}</tbody></table></section>
<section class="card"><h2>Affectations</h2><form class="form-grid" method="get"><label>Enseignant<select name="teacher_id"><option value="0">Tous les enseignants</option>{% for teacher in teachers %}<option value="{{ teacher.id }}" {{ teacher.id == teacherId ? 'selected' : '' }}>{{ teacher.last_name }} {{ teacher.first_name }}</option>{% endfor %}</select></label><button class="button" type="submit">Filtrer</button></form><table><thead><tr><th>Enseignant</th><th>Classe</th><th>Matiere</th><th>Heures</th><th></th></tr></thead><tbody>{% for assignment in assignments %}<tr><td>{{ assignment.last_name }} {{ assignment.first_name }}</td><td>{{ assignment.class_name }}</td><td>{{ assignment.subject_name }}</td><td>{{ assignment.weekly_hours }} h</td><td><form method="post"><input type="hidden" name="action" value="unassign"><input type="hidden" name="_token" value="{{ csrf_token('teacher_unassign') }}"><input type="hidden" name="assignment_id" value="{{ assignment.id }}"><button class="button" type="submit">Retirer</button></form></td></tr>{% else %}<tr><td colspan="5">Aucune affectation.</td></tr>{% endfor %}</tbody></table></section>
</div></main></div></body></html>
